{
  "name": "leap-second-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "23:59:60, a timekeeping lab: TAI, UTC, GPS, Unix and UT1 on one timeline, a step vs smear vs monotonic clock simulator, a library test bench with recorded outputs from Node, Python and Postgres, and leap-second bug-fix exercises. Entirely client-side.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts",
    "bench": "node scripts/record-bench.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@js-temporal/polyfill": "^0.4.4",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
