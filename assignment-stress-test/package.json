{
  "name": "assignment-stress-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paste a short fork/wait/exit/printf C snippet and see every process it creates, every output the scheduler could produce, why other outputs are impossible, and verified exam questions. Entirely client-side.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test scripts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^2.1.9"
  }
}
