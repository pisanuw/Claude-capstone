{
  "name": "edit-graph-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "See diff as a shortest-path search: draw the edit graph of two texts, animate Myers' O(ND) algorithm with its V array, and compare LCS, Myers, patience and histogram diff. Entirely client-side.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/diff": "^7.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "diff": "^7.0.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
