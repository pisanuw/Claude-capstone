# backend-hub environment.
#
# The hub itself only reads PORT. Everything else belongs to the mounted apps.
# Convention: apps added after the hub was created use a name prefix
# (CHAT_..., DSA_...); mult-streak predates the hub and keeps its
# historical unprefixed names.

PORT=3000

# --- mult-streak (mounted at /mult-streak) ---
# Secret used to sign the game-state cookie. Required in production.
COOKIE_SECRET=change-me
# Minutes of inactivity before the "player stopped" email fires.
IDLE_MINUTES=5
# Resend credentials; email is disabled unless both are present.
RESEND_API=
ADMIN_EMAIL=
FROM_EMAIL=mult-streak@pisan.me

# --- /chat (reserved for chatwithdigitalme) ---
# CHAT_...

# --- /dsa (reserved for dsa-instructor) ---
# DSA_...
