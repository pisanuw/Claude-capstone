exports[`svg > matches the golden SVG for the login example 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" id="tsvg" class="dle" viewBox="0 0 714 747" width="714" height="747" role="img"><style>#tsvg{--dle-font:system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;--dle-bg:#ffffff;--dle-node-fill:#eef2ff;--dle-node-stroke:#6366f1;--dle-node-text:#1e1b4b;--dle-edge:#475569;--dle-label-bg:#ffffff;--dle-label-text:#334155;--dle-cluster-fill:#f8fafc;--dle-cluster-stroke:#cbd5e1;--dle-cluster-text:#475569;--dle-added:#16a34a;--dle-added-fill:#dcfce7;--dle-removed:#dc2626;--dle-removed-fill:#fee2e2;--dle-changed:#d97706;--dle-changed-fill:#fef3c7;--dle-focus:#f43f5e}#tsvg{font-family:var(--dle-font);font-size:14px}#tsvg .dle-bg{fill:var(--dle-bg)}#tsvg .dle-node-shape{fill:var(--dle-node-fill);stroke:var(--dle-node-stroke);stroke-width:1.5}#tsvg .dle-node-text{fill:var(--dle-node-text)}#tsvg .dle-cluster rect{fill:var(--dle-cluster-fill);stroke:var(--dle-cluster-stroke);stroke-width:1.2}#tsvg .dle-cluster-title{fill:var(--dle-cluster-text);font-size:13px;font-weight:600}#tsvg .dle-edge-path{fill:none;stroke:var(--dle-edge);stroke-width:1.6}#tsvg .dle-hit{fill:none;stroke:transparent;stroke-width:10}#tsvg .dle-thick .dle-edge-path{stroke-width:3.2}#tsvg .dle-dotted .dle-edge-path{stroke-dasharray:3 4}#tsvg .dle-edge-label rect{fill:var(--dle-label-bg);opacity:.92}#tsvg .dle-label-text{fill:var(--dle-label-text);font-size:12.5px}#tsvg .dle-debug{fill:var(--dle-focus);font-size:9px;font-family:ui-monospace,monospace}#tsvg .dle-added .dle-node-shape,#tsvg .dle-cluster.dle-added rect{fill:var(--dle-added-fill);stroke:var(--dle-added);stroke-width:2.5}#tsvg .dle-removed .dle-node-shape,#tsvg .dle-cluster.dle-removed rect{fill:var(--dle-removed-fill);stroke:var(--dle-removed);stroke-width:2.5}#tsvg .dle-changed .dle-node-shape,#tsvg .dle-cluster.dle-changed rect{fill:var(--dle-changed-fill);stroke:var(--dle-changed);stroke-width:2.5}#tsvg .dle-edge.dle-adde